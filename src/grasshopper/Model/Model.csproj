<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Version>0.9.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Rangekeeper.Model</AssemblyName>
    <RootNamespace>Rangekeeper</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Generated/*.cs;Serialization/*.cs;Authoring/*.cs;Validation/*.cs" />
    <EmbeddedResource Include="Generated/schema.json;Generated/slots.json" />
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
  </ItemGroup>
</Project>
